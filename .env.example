# ===== Server =====
ENVIRONMENT=development
PORT=8080
BASE_URL=http://localhost:8080
# Orígenes permitidos por CORS, separados por coma. "*" permite cualquier origen
# pero SIN credenciales (combinación inválida según la spec CORS). Para usar
# credenciales, lista orígenes concretos:
#   CORS_ALLOWED_ORIGINS=https://app.tudominio.com,https://admin.tudominio.com
CORS_ALLOWED_ORIGINS=*
# Proxies inversos de confianza (IPs/CIDR separados por coma). Solo se honra el
# X-Forwarded-For que venga de estos saltos; vacío = se ignora XFF y se usa la
# IP del socket directo. Configúralo SOLO si la app vive detrás de un proxy/LB;
# confiar en cualquier proxy permite spoofear la IP y evadir el rate-limit.
#   TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=

# ===== Database =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=generic_backend
DB_MAX_CONN=25
DB_IDLE_CONN=5

# ===== JWT =====
# Generate a strong random secret. NEVER commit a real secret.
JWT_SECRET=
JWT_EXPIRATION=24
# 8760h = 1 año. /auth/refresh rota el refresh, así la sesión vive
# mientras el usuario abra la app al menos una vez al año.
JWT_REFRESH=8760

# ===== Storage =====
STORAGE_PATH=./uploads
MAX_FILE_SIZE=5242880

# ===== Branding =====
# Aparecen en From / Subject / heading del HTML del correo de verificación.
APP_NAME=MyApp
APP_BRAND_COLOR=#000000

# ===== Email =====
# El envío real lo hace el MTA local (sendmail). HOST/PORT son informativos.
SMTP_FROM=noreply@example.com
SMTP_HOST=localhost
SMTP_PORT=25
# true = no envía correo (tests / dev sin MTA)
EMAIL_NOOP=false

# ===== Admin (opcional) =====
# Si configuras los tres, se siembra un usuario admin (idempotente).
# Si falta cualquiera, no se siembra. NO existe hash por defecto.
# Generá tu hash con: htpasswd -nbBC 10 "" "tu_password" | tr -d ':\n'
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_NAME=Admin
ADMIN_PASSWORD_HASH=

# ===== Auth flags =====
# true = referral_code obligatorio en /auth/register
REQUIRE_REFERRAL=false
