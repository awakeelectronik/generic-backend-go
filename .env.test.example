# Copia a .env.test y ajusta SOLO si tu MySQL difiere del de docker-compose.test.yml.
# Con `make test-integration-docker` estos valores ya funcionan tal cual, así que
# .env.test es opcional. (.env.test está en .gitignore.)

# ===== Test database =====
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASS=password
# El nombre DEBE contener "test": es un guard de seguridad que se valida antes
# de hacer DROP DATABASE, para no destruir una BD real por accidente.
TEST_DB_NAME=genericbackendtest

# ===== Test JWT / storage =====
TEST_JWT_SECRET=test-secret
TEST_JWT_ISSUER=test-issuer
TEST_STORAGE_PATH=./uploads-test
